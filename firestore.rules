rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    
    // Questions collection (read-only for users)
    match /questions/{questionId} {
      allow read: if true;
      allow write: if true; // Change to admin-only in production
    }
    
    // Answer opinions collection (read-only for users)
    match /answer_opinions/{opinionId} {
      allow read: if true;
      allow write: if true; // Change to admin-only in production
    }
    
    // User answers collection
    match /user_answers/{answerId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    
    // Likes collection
    match /likes/{likeId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    
    // Matches collection
    match /matches/{matchId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    
    // Chats collection
    match /chats/{chatId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
    
    // Messages collection
    match /messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
